apiVersion: argoproj.io/v1alpha1
kind: WorkflowTemplate
metadata:
  name: sap-ai-core-poc-training
  annotations:
    scenarios.ai.sap.com/description: "POC Training Pipeline"
    scenarios.ai.sap.com/name: "sap-ai-core-poc"
    executables.ai.sap.com/description: "Train the POC model"
    executables.ai.sap.com/name: "poc-training"
  labels:
    scenarios.ai.sap.com:id: "sap-ai-core-poc"
    ai.sap.com/version: "1.0.0"
spec:
  entrypoint: training-pipeline
  templates:
    - name: training-pipeline
      steps:
        - - name: train
            template: train-step

    - name: train-step
      metadata:
        labels:
          ai.sap.com/resourcePlan: starter
      container:
        # Replace with the image you build from the training/Dockerfile
        image: docker.io/your-org/transaction-analyzer-training:latest
        workingDir: /app
        command: ["python"]
        args: ["trainer.py"]
        env:
          - name: MODEL_DIR
            value: "/app/models"
          - name: S3_BUCKET
            value: "your-s3-bucket"
          - name: S3_ENDPOINT
            value: "s3.amazonaws.com"
          - name: AWS_ACCESS_KEY_ID
            value: "REPLACE_ME"
          - name: AWS_SECRET_ACCESS_KEY
            value: "REPLACE_ME"
          - name: S3_PATH_PREFIX
            value: "ai/transaction-analyzer"
        resources:
          limits:
            cpu: "2"
            memory: "4Gi"
      outputs:
        artifacts:
          - name: model-output
            globalName: trainedmodels
            path: /app/models
            archive:
              none: {}
